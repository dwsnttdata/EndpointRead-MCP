# Microsoft Graph API Configuration
# Copy this file to .env and fill in your values

# Azure AD App Registration
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Authentication mode. OBO is the active hosted MCP mode.
AUTH_MODE=obo

# The audience defaults to api://<CLIENT_ID>; override if your Application ID URI differs.
MCP_API_AUDIENCE=api://<your-app-client-id>
MCP_API_SCOPE=Mcp.Access

# Legacy app-only configuration retained for a later deployment; do not enable here.
# AUTH_MODE=app
# Legacy interactive sign-in settings; Copilot Studio performs sign-in in OBO mode.
# REQUIRE_USER_LOGIN=false
# USER_AUTH_SCOPES=User.Read
# INTERACTIVE_LOGIN_MODE=device_code

# Optional token cache path for interactive sign-in
# TOKEN_CACHE_PATH=E:\\MCP\\intune-mcp-server\\.msal_token_cache.bin

# Optional: Graph API endpoint (default is global)
# GRAPH_ENDPOINT=https://graph.microsoft.com/v1.0
# Use beta for newer features:
# GRAPH_ENDPOINT=https://graph.microsoft.com/beta
