# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# Not secrets, but environment-specific. The OAuth client secret is NOT stored here (it lives in the Microsoft Enterprise token store).

# Stable GUID for this app package. Generate once: [guid]::NewGuid()
APP_ID=00000000-0000-0000-0000-000000000000

# DataHub MCP endpoint (must end with /mcp)
MCP_SERVER_URL=https://<DATAHUB_HOST>/mcp

# Teams developer portal > Tools > OAuth client registration > registration ID
OAUTH_REFERENCE_ID=<OAUTH_CLIENT_REGISTRATION_ID>

# Shown in the app details. Must be https URLs.
DEVELOPER_NAME=<Your organization>
DEVELOPER_WEBSITE_URL=https://<your-website>
DEVELOPER_PRIVACY_URL=https://<your-privacy-statement>
DEVELOPER_TERMS_URL=https://<your-terms-of-use>
